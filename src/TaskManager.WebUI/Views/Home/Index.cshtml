@using Microsoft.Extensions.Localization
@model HomePageViewModel
@inject IStringLocalizer<SharedResource> Text
@{
    ViewData["Title"] = Text["PageTitle"];
}

<div class="landing-shell">
    <aside class="app-sidebar" aria-label="@Text["MainNavigationLabel"]">
        <a class="brand" asp-controller="Home" asp-action="Index" aria-label="@Text["HomeLinkLabel"]">
            <span class="brand__mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" role="img">
                    <path d="m7.5 12 3 3 6-7" />
                </svg>
            </span>
            <span class="brand__name">TaskFlow</span>
        </a>

        <nav class="sidebar-nav">
            <span class="sidebar-nav__label">@Text["WorkspaceLabel"]</span>

            @if (Model.Boards.Count > 0)
            {
                <div class="sidebar-board-list" aria-label="บอร์ดของคุณ">
                    @foreach (var board in Model.Boards)
                    {
                        <a class="sidebar-board-link"
                           asp-controller="Boards"
                           asp-action="Index"
                           asp-route-publicId="@board.PublicId"
                           title="@board.Name">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <rect x="4" y="4" width="16" height="16" rx="3" />
                                <path d="M9 4v16M9 10h11" />
                            </svg>
                            <span>@board.Name</span>
                            <i aria-hidden="true"></i>
                        </a>
                    }
                </div>
            }

            @if (Model.Guest is not null)
            {
                <form class="sidebar-action-form"
                      asp-controller="Boards"
                      asp-action="Create"
                      method="post">
                    <input type="hidden" name="name" value="บอร์ดใหม่" />
                    <button class="sidebar-action" type="submit">
                        <span class="sidebar-action__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" role="img">
                                <path d="M12 5v14M5 12h14" />
                            </svg>
                        </span>
                        <span>
                            <strong>@Text["CreateBoard"]</strong>
                            <small>@Text["CreateBoardDescription"]</small>
                        </span>
                    </button>
                </form>
            }
            else
            {
                <a class="sidebar-action" href="#start-trial">
                    <span class="sidebar-action__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" role="img">
                            <path d="M12 5v14M5 12h14" />
                        </svg>
                    </span>
                    <span>
                        <strong>@Text["CreateBoard"]</strong>
                        <small>@Text["CreateBoardDescription"]</small>
                    </span>
                </a>
            }
        </nav>

        @if (Model.Guest is not null)
        {
            <div class="sidebar-note">
                <span class="sidebar-note__avatar"
                      style="@($"background-color: {Model.Guest.AvatarColor};")"
                      aria-hidden="true">
                    @Model.Guest.ShortName
                </span>

                <div>
                    <strong>@Model.Guest.DisplayName</strong>
                </div>
            </div>
        }
        else
        {
            <div class="sidebar-note">
                <span class="sidebar-note__dot" aria-hidden="true"></span>
                <div>
                    <strong>@Text["PublicDemo"]</strong>
                    <span>@Text["NoRegistration"]</span>
                </div>
            </div>
        }

    </aside>

    <main class="landing-main">
        <header class="topbar">
            <div>
                <span class="topbar__eyebrow">TASKFLOW</span>
                <h1 class="topbar__title">@Text["DemoTitle"]</h1>
                <p class="topbar__subtitle">@Text["DemoSubtitle"]</p>
            </div>

            <span class="demo-status">
                <span class="demo-status__dot" aria-hidden="true"></span>
                @Text["ReadyToTry"]
            </span>
        </header>

        <section class="hero" id="start-trial" aria-labelledby="landing-title">
            <div class="hero__glow hero__glow--one" aria-hidden="true"></div>
            <div class="hero__glow hero__glow--two" aria-hidden="true"></div>

            <div class="hero__content">
                <span class="hero__badge">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 3 4.5 7v5c0 4.7 3.2 7.7 7.5 9 4.3-1.3 7.5-4.3 7.5-9V7L12 3Z" />
                        <path d="m8.7 12 2.1 2.1 4.5-4.5" />
                    </svg>
                    @Text["PublicDemoArea"]
                </span>

                <h2 id="landing-title">@Text["HeroTitleLine1"]<br /><span>@Text["HeroTitleLine2"]</span></h2>
                <p class="hero__description">
                    @Text["HeroDescriptionLine1"]<br class="desktop-only" />
                    @Text["HeroDescriptionLine2"]
                </p>

                <div class="hero__features" aria-label="@Text["FeatureListLabel"]">
                    <span>
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 12 3 3 7-7" /></svg>
                        @Text["FeatureStartImmediately"]
                    </span>
                    <span>
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" /></svg>
                        @Text["FeatureShareLink"]
                    </span>
                    <span>
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 8v4l3 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
                        @Text["FeatureTemporaryUsage"]
                    </span>
                </div>

                <form class="trial-form"
                      asp-controller="Home"
                      asp-action="TryDemo"
                      method="post">
                    <button id="demo-btn"
                            class="primary-cta"
                            type="submit"
                            aria-describedby="trial-note">
                        <span>@Text["StartTrial"]</span>
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M5 12h14M13 6l6 6-6 6" />
                        </svg>
                    </button>
                </form>
                <p class="trial-note" id="trial-note">@Text["TrialNote"]</p>

                <aside class="demo-disclaimer" aria-label="@Text["DisclaimerLabel"]">
                    <span class="demo-disclaimer__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <path d="M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20Z" />
                            <path d="M12 10v6M12 7h.01" />
                        </svg>
                    </span>
                    <p>
                        <strong>@Text["DisclaimerTitle"]</strong>
                        @Text["DisclaimerBody"]
                    </p>
                </aside>

                <a class="github-link"
                   href="https://github.com/Issarat/task-managements"
                   target="_blank"
                   rel="noopener noreferrer"
                   aria-label="@Text["GitHubLinkLabel"]">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3.3-.4 6.8-1.6 6.8-7A5.4 5.4 0 0 0 19.4 4 5 5 0 0 0 19.3.5S18.2.1 15 1.8a13.4 13.4 0 0 0-7 0C4.8.1 3.7.5 3.7.5A5 5 0 0 0 3.6 4a5.4 5.4 0 0 0-1.4 3.7c0 5.3 3.5 6.5 6.8 6.9A4.8 4.8 0 0 0 8 18v4" />
                        <path d="M8 19c-3 .9-3-1.5-4.2-2" />
                    </svg>
                    <span>@Text["GitHubLinkText"]</span>
                    <svg class="github-link__arrow" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M7 17 17 7M7 7h10v10" />
                    </svg>
                </a>
            </div>

            <div class="board-preview" aria-hidden="true">
                <div class="board-preview__top">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
                <div class="board-preview__columns">
                    <div class="preview-column">
                        <span class="preview-column__title preview-column__title--gray"></span>
                        <div class="preview-card">
                            <i class="preview-tag preview-tag--red"></i>
                            <b></b><em></em>
                        </div>
                    </div>
                    <div class="preview-column">
                        <span class="preview-column__title preview-column__title--purple"></span>
                        <div class="preview-card preview-card--raised">
                            <i class="preview-tag preview-tag--purple"></i>
                            <b></b><em></em>
                        </div>
                        <div class="preview-card preview-card--small">
                            <i class="preview-tag preview-tag--green"></i>
                            <b></b>
                        </div>
                    </div>
                    <div class="preview-column">
                        <span class="preview-column__title preview-column__title--blue"></span>
                        <div class="preview-card">
                            <i class="preview-tag preview-tag--blue"></i>
                            <b></b><em></em>
                        </div>
                    </div>
                    <div class="preview-column">
                        <span class="preview-column__title preview-column__title--green"></span>
                        <div class="preview-card preview-card--small">
                            <i class="preview-tag preview-tag--green"></i>
                            <b></b>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>
</div>

