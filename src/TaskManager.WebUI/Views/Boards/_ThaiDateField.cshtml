@using System.Globalization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Text
@model ThaiDateFieldViewModel
@{
    var id = Html.Id(Model.FieldName);
    var iso = Model.Value?.ToIsoDateString() ?? string.Empty;
    if (ViewData.ModelState.TryGetValue(Model.FieldName, out var submitted) && submitted.AttemptedValue is not null)
        iso = submitted.AttemptedValue;
    var full = DateOnly.TryParseExact(iso, "yyyy-MM-dd", CultureInfo.InvariantCulture,
        DateTimeStyles.None, out var date) ? date.ToFullThaiDatetime() : string.Empty;
}
<div class="board-dialog__field">
    <label id="@(id)_label" for="@id">@Text[Model.LabelKey]</label>
    <div class="thai-date-control" data-thai-date
         data-format-url="@Url.Action("Format", "Dates")"
         data-format-error="@Text["TaskDateFormatError"]">
        <input type="date" id="@id" name="@Model.FieldName" value="@iso"
               min="0001-01-01" max="9999-12-31"
               class="thai-date-source" data-date-source aria-labelledby="@(id)_label" />
        <input type="text" id="@(id)_text" class="thai-date-display" data-date-display
               value="@full" readonly hidden placeholder="@Text["TaskDatePlaceholder"]"
               aria-labelledby="@(id)_label" aria-describedby="@(id)_status" />
        <button class="thai-date-clear" type="button" data-date-clear hidden
                aria-label="@Text["TaskDateClear"]" title="@Text["TaskDateClear"]">×</button>
        <button class="thai-date-open" type="button" data-date-open hidden
                aria-label="@Text["TaskDateChoose"]" title="@Text["TaskDateChoose"]">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="15" rx="2" /><path d="M8 3v4M16 3v4M4 10h16" /></svg>
        </button>
    </div>
    <small id="@(id)_status" data-date-status hidden role="status" aria-live="polite"></small>
</div>
