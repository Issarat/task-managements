@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Text
@model BoardPageViewModel
@{
    ViewData["Title"] = Model.Name;
    var editTaskColumnIndex = Model.Columns.ToList().FindIndex(column =>
        column.Tasks.Any(task => task.TaskItemId == Model.EditTask.TaskItemId));

    string FormatDate(DateOnly? value) =>
        value?.ToShortThaiDatetime() ?? Text["BoardEmptyValue"].Value;
}

@section Styles {
    <link rel="stylesheet" href="~/css/board.css" asp-append-version="true" />
}

<div class="board-screen" data-board-screen
     data-board-public-id="@Model.PublicId"
     data-task-editing-hint="@Text["TaskEditingBy"]"
     data-board-refresh-url="@Url.Action("Snapshot", "Boards", new { publicId = Model.PublicId })">
    <button class="board-sidebar-overlay"
            type="button"
            data-board-sidebar-close
            aria-label="@Text["BoardCloseMenu"]">
    </button>

    <aside class="board-sidebar" data-board-sidebar aria-label="@Text["BoardNavigationLabel"]">
        <a class="board-brand" asp-controller="Home" asp-action="Index">
            <span class="board-brand__mark" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="m7.5 12 3 3 6-7" /></svg>
            </span>
            <strong>@Text["AppName"]</strong>
        </a>

        <div class="board-sidebar__workspace">
            <span>@Text["WorkspaceLabel"]</span>
            @foreach (var board in Model.NavigationBoards)
            {
                <a class="board-sidebar__link @(board.IsActive ? "is-active" : null)"
                   asp-controller="Boards"
                   asp-action="Index"
                   asp-route-publicId="@board.PublicId"
                   aria-current="@(board.IsActive ? "page" : null)">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <rect x="4" y="4" width="16" height="16" rx="3" />
                        <path d="M9 4v16M9 10h11" />
                    </svg>
                    <span>@board.Name</span>
                    <i aria-hidden="true"></i>
                </a>
            }
        </div>

        <button class="board-create-card"
                type="button"
                data-dialog-open="create-board-dialog">
            <span aria-hidden="true">+</span>
            <span>
                <strong>@Text["CreateBoard"]</strong>
                <small>@Text["BoardCreateDescription"]</small>
            </span>
        </button>

        <div class="board-sidebar__spacer"></div>

        <div class="board-user">
            <span class="board-avatar"
                  style="@($"--avatar-color: {Model.CurrentGuest.AvatarColor};")">
                @Model.CurrentGuest.ShortName
            </span>
            <span>
                <strong>@Model.CurrentGuest.DisplayName</strong>
                <small>@Text["BoardGuestAccount"]</small>
            </span>
            <button type="button" aria-label="@Text["BoardUserMenu"]">
                <i></i><i></i><i></i>
            </button>
        </div>
    </aside>

    <main class="board-workspace">
        <header class="board-header">
            <button class="board-mobile-menu"
                    type="button"
                    data-board-sidebar-open
                    aria-label="@Text["BoardOpenMenu"]"
                    aria-expanded="false">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
            </button>

            <div class="board-heading">
                <div>
                    <h1 title="@Model.Name">@Model.Name</h1>
                    <span class="board-live-status"><i></i>@Text["BoardReady"]</span>
                </div>
                <p title="@Model.Description">@Model.Description</p>
            </div>

            <div class="board-header__actions">
                <div class="board-members" data-board-online-members
                     aria-label="@Text["BoardOnlineMembersLabel"]" aria-live="polite"
                     data-online-hint="@Text["BoardOnlineMemberHint"]">
                </div>

                <button class="board-primary-action" type="button"
                        aria-label="@Text["BoardAddTask"]"
                        data-dialog-open="create-task-dialog">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                    @Text["BoardAddTask"]
                </button>
            </div>
        </header>

        <section class="board-content" aria-label="@Text["BoardKanbanLabel"]">
            <div class="board-toolbar">
                <div class="board-tabs" role="tablist" aria-label="@Text["BoardViewLabel"]">
                    <button class="is-active" type="button" role="tab" aria-selected="true">@Text["BoardTab"]</button>
                </div>

                <div class="board-tools">
                    <button class="board-tool board-tool--share" type="button"
                            data-dialog-open="share-board-dialog">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7 .2l3-3a5 5 0 0 0-7-7l-2 2m3 6a5 5 0 0 0-7-.2l-3 3a5 5 0 0 0 7 7l2-2" /></svg>
                        @Text["BoardShare"]
                    </button>
                    <button class="board-tool board-tool--edit"
                            type="button"
                            data-dialog-open="update-board-dialog"
                            disabled="@(!Model.CanManage ? "disabled" : null)"
                            title="@(Model.CanManage ? Text["BoardEditHint"] : Text["BoardOwnerOnlyHint"])">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m4 20 4.5-1 10-10a2.1 2.1 0 0 0-3-3l-10 10zM14 7l3 3" /></svg>
                        @Text["BoardManage"]
                    </button>
                    <button class="board-tool board-tool--reset"
                            type="button"
                            data-dialog-open="reset-board-dialog"
                            disabled="@(!Model.CanManage ? "disabled" : null)"
                            title="@(Model.CanManage ? Text["BoardResetHint"] : Text["BoardOwnerOnlyHint"])">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M20 7v5h-5" />
                            <path d="M19 12a7.5 7.5 0 1 1-2.2-5.3L20 9" />
                        </svg>
                        @Text["BoardReset"]
                    </button>
                </div>
            </div>
            <p class="board-drag-hint">@Text["TaskDragHint"]</p>
            @if (TempData["BoardChangeError"] is string boardChangeError)
            {
                <p class="board-move-error" role="alert">@boardChangeError</p>
            }
            <p class="board-move-error" data-task-move-error role="alert"
               hidden="@(TempData["TaskMoveError"] is null)">@TempData["TaskMoveError"]</p>
            <form asp-controller="Boards" asp-action="MoveTask"
                  asp-route-publicId="@Model.PublicId" method="post" hidden
                  data-task-move-form
                  data-step-error="@Text["TaskColumnStepValidation"]"
                  data-moving-message="@Text["TaskMoving"]">
                <input type="hidden" name="taskId" />
                <input type="hidden" name="targetColumnId" />
                <input type="hidden" name="rowVersion" />
            </form>
            <div class="kanban-grid">
                @for (var columnIndex = 0; columnIndex < Model.Columns.Count; columnIndex++)
                {
                    var column = Model.Columns[columnIndex];
                    <section class="kanban-column tone-@column.Tone" data-column-key="@column.Key"
                             data-column-id="@column.ColumnId" data-column-index="@columnIndex">
                        <header class="kanban-column__header">
                            <div>
                                <i aria-hidden="true"></i>
                                <h2>@column.Name</h2>
                                <span>@column.Tasks.Count</span>
                            </div>
                        </header>

                        <div class="kanban-column__tasks">
                            @foreach (var task in column.Tasks)
                            {
                                <article class="kanban-card" draggable="true"
                                         data-task-id="@task.TaskItemId" data-row-version="@task.RowVersion">
                                    <span class="kanban-card__drag-handle" aria-hidden="true"
                                          title="@Text["TaskDragHandle"]">
                                        <svg viewBox="0 0 16 24"><path d="M5 5h.01M11 5h.01M5 12h.01M11 12h.01M5 19h.01M11 19h.01" /></svg>
                                    </span>
                                    <h3><a class="kanban-card__open"
                                           draggable="false"
                                           asp-controller="Boards" asp-action="Index"
                                           asp-route-publicId="@Model.PublicId"
                                           asp-route-taskId="@task.TaskItemId"
                                           aria-label="@Text["TaskOpenLabel", task.Title]">@task.Title</a></h3>
                                    <p>@task.Description</p>
                                    <span class="kanban-card__priority priority-@task.PriorityTone">
                                        <i aria-hidden="true"></i>
                                        @task.Priority
                                    </span>

                                    <footer>
                                        <div class="kanban-card__person" title="@task.AssigneeDisplayName">
                                            <span class="kanban-card__assignee"
                                                  style="@($"--avatar-color: {task.AssigneeColor};")">
                                                @task.AssigneeShortName
                                            </span>
                                            <span class="kanban-card__person-name">@task.AssigneeDisplayName</span>
                                        </div>
                                        <div class="kanban-card__dates">
                                        <span class="kanban-card__date" title="@task.StartDate?.ToFullThaiDatetime()">
                                            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="15" rx="2" /><path d="M8 3v4M16 3v4M4 10h16" /></svg>
                                            @FormatDate(task.StartDate)
                                        </span>
                                        <span class="kanban-card__date" title="@task.DueDate?.ToFullThaiDatetime()">
                                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12V5H4v16h9M8 3v4M15 3v4M4 10h15m-5 9 3 3 5-6" /></svg>
                                            @FormatDate(task.DueDate)
                                        </span>
                                        </div>
                                    </footer>
                                </article>
                            }
                        </div>
                    </section>
                }
            </div>
        </section>
    </main>
</div>

<!------------------------- Model --------------------------->

<dialog class="board-dialog" id="share-board-dialog" aria-labelledby="share-board-title">
    <header class="board-dialog__header">
        <div>
            <h2 id="share-board-title">@Text["BoardShare"]</h2>
            <p>@Text["BoardShareDescription"]</p>
        </div>
        <button class="board-dialog__close" type="button" data-dialog-close
                aria-label="@Text["BoardCloseDialog"]">×</button>
    </header>
    <div class="board-dialog__content">
        <label class="board-dialog__field">
            <span>@Text["BoardShareLinkLabel"]</span>
            <input type="text" readonly data-share-link data-dialog-initial-focus
                   data-share-path="@Url.Action("Index", "Boards", new { publicId = Model.PublicId })"
                   value="@Url.Action("Index", "Boards", new { publicId = Model.PublicId })" />
        </label>
        <p class="board-share-note">@Text["BoardSharePermissions"]</p>
        <p class="board-share-note">@Text["BoardShareExpiry"]</p>
        <p class="board-share-status" data-share-status role="status" aria-live="polite"
           data-copied-message="@Text["BoardShareCopied"]"
           data-failed-message="@Text["BoardShareCopyFallback"]"></p>
    </div>
    <footer class="board-dialog__actions">
        <button class="board-dialog__button board-dialog__button--secondary" type="button"
                data-dialog-close>@Text["BoardCloseDialog"]</button>
        <button class="board-dialog__button board-dialog__button--primary" type="button"
                data-share-copy>@Text["BoardShareCopy"]</button>
    </footer>
</dialog>

<dialog class="board-dialog" id="create-task-dialog"
        data-dialog-auto-open="@(Model.ShowCreateTaskDialog ? "true" : null)"
        aria-labelledby="create-task-title">
    <form class="board-dialog__form"
          asp-controller="Boards" asp-action="CreateTask"
          asp-route-publicId="@Model.PublicId" method="post">
        <header class="board-dialog__header">
            <div>
                <h2 id="create-task-title">@Text["BoardAddTask"]</h2>
                <p>@Text["TaskCreateDescription"]</p>
            </div>
            <button class="board-dialog__close" type="button" data-dialog-close
                    aria-label="@Text["BoardCloseDialog"]">×</button>
        </header>
        <div class="board-dialog__content">
            <div asp-validation-summary="All" class="board-form-errors" role="alert"></div>
            <label class="board-dialog__field">
                <span>@Text["TaskTitleLabel"] <i>*</i></span>
                <input asp-for="CreateTask.Title" maxlength="60" required
                       placeholder="@Text["TaskTitlePlaceholder"]" data-dialog-initial-focus />
            </label>
            <label class="board-dialog__field">
                <span>@Text["BoardDescriptionLabel"]</span>
                <textarea asp-for="CreateTask.DescriptionMarkdown" maxlength="20000"
                          rows="3" placeholder="@Text["TaskDescriptionPlaceholder"]"></textarea>
            </label>
            <div class="board-dialog__row">
                <label class="board-dialog__field">
                    <span>@Text["TaskColumnLabel"]</span>
                    <select disabled aria-label="@Text["TaskColumnLabel"]">
                        <option selected>@Text["TaskDefaultColumn"]</option>
                    </select>
                </label>
                <label class="board-dialog__field">
                    <span>@Text["TaskPriorityLabel"]</span>
                    <select asp-for="CreateTask.Priority">
                        <option value="1">@Text["BoardPriorityLow"]</option>
                        <option value="2">@Text["BoardPriorityMedium"]</option>
                        <option value="3">@Text["BoardPriorityHigh"]</option>
                    </select>
                </label>
            </div>
            <label class="board-dialog__field">
                <span>@Text["TaskAssigneeLabel"]</span>
                <select asp-for="CreateTask.AssignedToParticipantId">
                    <option value="">@Text["BoardUnassigned"]</option>
                    @foreach (var member in Model.Members)
                    {
                        <option value="@member.ParticipantId">@member.DisplayName</option>
                    }
                </select>
            </label>
            <div class="board-dialog__row">
                <partial name="_ThaiDateField" model='new ThaiDateFieldViewModel("CreateTask.StartDate", "BoardStartDate", Model.CreateTask.StartDate)' />
                <partial name="_ThaiDateField" model='new ThaiDateFieldViewModel("CreateTask.DueDate", "BoardDueDate", Model.CreateTask.DueDate)' />
            </div>
        </div>
        <footer class="board-dialog__actions">
            <button class="board-dialog__button board-dialog__button--secondary"
                    type="button" data-dialog-close>@Text["BoardCancel"]</button>
            <button class="board-dialog__button board-dialog__button--primary"
                    type="submit">@Text["TaskCreateSubmit"]</button>
        </footer>
    </form>
</dialog>

<dialog class="board-dialog" id="edit-task-dialog"
        data-editing-task-id="@Model.EditTask.TaskItemId"
        data-dialog-auto-open="@(Model.ShowEditTaskDialog ? "true" : null)"
        aria-labelledby="edit-task-title">
    <form class="board-dialog__form"
          asp-controller="Boards" asp-action="UpdateTask"
          asp-route-publicId="@Model.PublicId" method="post">
        <input asp-for="EditTask.TaskItemId" type="hidden" />
        <input asp-for="EditTask.RowVersion" type="hidden" />
        <header class="board-dialog__header">
            <div>
                <h2 id="edit-task-title">@Text["TaskEditTitle"]</h2>
                <p>@Text["TaskEditDescription"]</p>
            </div>
            <button class="board-dialog__close" type="button" data-dialog-close
                    aria-label="@Text["BoardCloseDialog"]">×</button>
        </header>
        <div class="board-dialog__content">
            <div asp-validation-summary="All" class="board-form-errors" role="alert"></div>
            <label class="board-dialog__field">
                <span>@Text["TaskTitleLabel"] <i>*</i></span>
                <input asp-for="EditTask.Title" maxlength="60" required
                       placeholder="@Text["TaskTitlePlaceholder"]" data-dialog-initial-focus />
            </label>
            <label class="board-dialog__field">
                <span>@Text["BoardDescriptionLabel"]</span>
                <textarea asp-for="EditTask.DescriptionMarkdown" maxlength="20000"
                          rows="3" placeholder="@Text["TaskDescriptionPlaceholder"]"></textarea>
            </label>
            <div class="board-dialog__row">
                <label class="board-dialog__field">
                    <span>@Text["TaskColumnLabel"]</span>
                    <select asp-for="EditTask.BoardColumnId" required>
                        @for (var index = 0; index < Model.Columns.Count; index++)
                        {
                            var column = Model.Columns[index];
                            <option value="@column.ColumnId"
                                    disabled="@(Math.Abs(index - editTaskColumnIndex) > 1)">@column.Name</option>
                        }
                    </select>
                </label>
                <label class="board-dialog__field">
                    <span>@Text["TaskPriorityLabel"]</span>
                    <select asp-for="EditTask.Priority">
                        <option value="1">@Text["BoardPriorityLow"]</option>
                        <option value="2">@Text["BoardPriorityMedium"]</option>
                        <option value="3">@Text["BoardPriorityHigh"]</option>
                    </select>
                </label>
            </div>
            <label class="board-dialog__field">
                <span>@Text["TaskAssigneeLabel"]</span>
                <select asp-for="EditTask.AssignedToParticipantId">
                    <option value="">@Text["BoardUnassigned"]</option>
                    @foreach (var member in Model.Members)
                    {
                        <option value="@member.ParticipantId">@member.DisplayName</option>
                    }
                </select>
            </label>
            <div class="board-dialog__row">
                <partial name="_ThaiDateField" model='new ThaiDateFieldViewModel("EditTask.StartDate", "BoardStartDate", Model.EditTask.StartDate)' />
                <partial name="_ThaiDateField" model='new ThaiDateFieldViewModel("EditTask.DueDate", "BoardDueDate", Model.EditTask.DueDate)' />
            </div>
        </div>
        <footer class="board-dialog__actions">
            <button class="board-dialog__button board-dialog__button--danger board-task-delete"
                    type="button" data-dialog-open="delete-task-dialog">@Text["TaskDelete"]</button>
            <button class="board-dialog__button board-dialog__button--secondary"
                    type="button" data-dialog-close>@Text["BoardCancel"]</button>
            <button class="board-dialog__button board-dialog__button--primary"
                    type="submit">@Text["BoardSave"]</button>
        </footer>
    </form>
</dialog>

<dialog class="board-dialog" id="delete-task-dialog"
        aria-labelledby="delete-task-title" aria-describedby="delete-task-description">
    <form class="board-dialog__form" asp-controller="Boards" asp-action="DeleteTask"
          asp-route-publicId="@Model.PublicId" method="post">
        <input type="hidden" name="taskId" value="@Model.EditTask.TaskItemId" />
        <input type="hidden" name="rowVersion" value="@Model.EditTask.RowVersion" />
        <header class="board-dialog__header">
            <h2 id="delete-task-title">@Text["TaskDelete"]</h2>
            <button class="board-dialog__close" type="button" data-dialog-close
                    aria-label="@Text["BoardCloseDialog"]">×</button>
        </header>
        <div class="board-dialog__content">
            <p id="delete-task-description">@Text["TaskDeleteConfirmation", Model.EditTask.Title]</p>
        </div>
        <footer class="board-dialog__actions">
            <button class="board-dialog__button board-dialog__button--secondary"
                    type="button" data-dialog-close autofocus>@Text["BoardCancel"]</button>
            <button class="board-dialog__button board-dialog__button--danger"
                    type="submit">@Text["TaskDeleteConfirm"]</button>
        </footer>
    </form>
</dialog>

<dialog class="board-dialog" id="create-board-dialog"
        data-dialog-auto-open="@(Model.ShowCreateBoardDialog ? "true" : null)"
        aria-labelledby="create-board-title">
    <partial name="_CreateBoardForm" model="Model.CreateBoard" />
</dialog>

<dialog class="board-dialog" id="update-board-dialog"
        data-dialog-auto-open="@(Model.ShowEditBoardDialog ? "true" : null)">
    <form class="board-dialog__form"
          asp-controller="Boards"
          asp-action="Update"
          asp-route-publicId="@Model.PublicId"
          method="post">
        <input asp-for="EditBoard.RowVersion" type="hidden" />
        <header class="board-dialog__header">
            <div>
                <h2>@Text["BoardManage"]</h2>
                <p>@Text["BoardUpdateDialogDescription"]</p>
            </div>
            <button type="button"
                    class="board-dialog__close"
                    data-dialog-close
                    aria-label="@Text["BoardCloseDialog"]">×</button>
        </header>

        <div class="board-dialog__content">
            @if (Model.ShowEditBoardDialog)
            {
                <div asp-validation-summary="All" class="board-dialog__validation" role="alert"></div>
            }
            <label class="board-dialog__field">
                <span>@Text["BoardNameLabel"] <i>*</i></span>
                <input asp-for="EditBoard.Name"
                       type="text"
                       maxlength="120"
                       required
                       autocomplete="off"
                       data-dialog-initial-focus />
            </label>

            <label class="board-dialog__field">
                <span>@Text["BoardDescriptionLabel"]</span>
                <textarea asp-for="EditBoard.Description"
                          maxlength="500"
                          rows="3"></textarea>
            </label>
        </div>

        <footer class="board-dialog__actions">
            @if (Model.BoardConflict)
            {
                <a class="board-dialog__button board-dialog__button--secondary"
                   asp-controller="Boards" asp-action="Index" asp-route-publicId="@Model.PublicId">@Text["BoardReload"]</a>
            }
            <button class="board-dialog__button board-dialog__button--secondary"
                    type="button"
                    data-dialog-close>@Text["BoardCancel"]</button>
            <button class="board-dialog__button board-dialog__button--primary"
                    type="submit">@Text["BoardSave"]</button>
        </footer>
    </form>
</dialog>

<dialog class="board-dialog" id="reset-board-dialog"
        aria-labelledby="reset-board-title"
        aria-describedby="reset-board-description">
    <form class="board-dialog__form"
          asp-controller="Boards"
          asp-action="Reset"
          asp-route-publicId="@Model.PublicId"
          method="post">
        <input type="hidden" name="rowVersion" value="@Model.BoardRowVersion" />
        <header class="board-dialog__header">
            <h2 id="reset-board-title">@Text["BoardReset"]</h2>
            <button type="button"
                    class="board-dialog__close"
                    data-dialog-close
                    aria-label="@Text["BoardCloseDialog"]">×</button>
        </header>
        <div class="board-dialog__content">
            <p id="reset-board-description">@Text["BoardResetConfirmation", Model.Name]</p>
        </div>
        <footer class="board-dialog__actions">
            <button class="board-dialog__button board-dialog__button--secondary"
                    type="button" autofocus
                    data-dialog-close>@Text["BoardCancel"]</button>
            <button class="board-dialog__button board-dialog__button--danger"
                    type="submit">@Text["BoardResetConfirm"]</button>
        </footer>
    </form>
</dialog>

@section Scripts {
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.js" asp-append-version="true"></script>
    <script src="~/js/board.js" asp-append-version="true"></script>
    <script src="~/js/thai-date.js" asp-append-version="true"></script>
    <script src="~/js/board-realtime.js" asp-append-version="true"></script>
}
