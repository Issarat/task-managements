@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Text
@model CreateBoardFormModel

<form class="board-dialog__form" asp-controller="Boards" asp-action="Create" method="post">
    <input asp-for="ReturnBoardPublicId" type="hidden" />
    <header class="board-dialog__header">
        <div>
            <h2 id="create-board-title">@Text["CreateBoard"]</h2>
            <p>@Text["BoardCreateDialogDescription"]</p>
        </div>
        @if (Model.ReturnBoardPublicId is not null)
        {
            <button type="button" class="board-dialog__close" data-dialog-close
                    aria-label="@Text["BoardCloseDialog"]">×</button>
        }
    </header>
    <div class="board-dialog__content">
        <div asp-validation-summary="All" class="board-form-errors" role="alert"></div>
        <label class="board-dialog__field">
            <span>@Text["BoardNameLabel"] <i>*</i></span>
            <input asp-for="Name" type="text" maxlength="120" required autocomplete="off"
                   placeholder="@Text["BoardNamePlaceholder"]" data-dialog-initial-focus />
        </label>
        <label class="board-dialog__field">
            <span>@Text["BoardDescriptionLabel"]</span>
            <textarea asp-for="Description" maxlength="500" rows="3"
                      placeholder="@Text["BoardDescriptionPlaceholder"]"></textarea>
        </label>
    </div>
    <footer class="board-dialog__actions">
        @if (Model.ReturnBoardPublicId is not null)
        {
            <button class="board-dialog__button board-dialog__button--secondary" type="button"
                    data-dialog-close>@Text["BoardCancel"]</button>
        }
        else
        {
            <a class="board-dialog__button board-dialog__button--secondary"
               asp-controller="Home" asp-action="Index">@Text["BoardCancel"]</a>
        }
        <button class="board-dialog__button board-dialog__button--primary" type="submit">@Text["BoardCreateSubmit"]</button>
    </footer>
</form>
